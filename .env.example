# ============================================================
#  متغيرات البيئة — متجر أريسا
#  انسخي هذا الملف إلى .env محلياً أو أضيفي القيم في Vercel
# ============================================================

# --- قاعدة البيانات ---
# محلي (SQLite):
DATABASE_URL="file:./db/custom.db"

# Vercel / الإنتاج (PostgreSQL — استخدمي Vercel Postgres أو Neon):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- كلمة سر لوحة التحكم (اختياري — الافتراضي admin1234) ---
# ADMIN_PASSWORD="admin1234"

# --- رقم الواتساب والهاتف (اختياري — يُقرأ من src/lib/brand.ts افتراضياً) ---
# BRAND_PHONE="+966550828817"
# BRAND_WHATSAPP="966550828817"
