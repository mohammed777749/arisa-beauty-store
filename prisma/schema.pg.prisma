// PostgreSQL schema for Vercel / production deployment
// This is a copy of schema.prisma with provider switched to "postgresql".
// Used by the build script: `bun run prisma:use-pg` swaps this in before generate.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  nameEn      String
  description String?
  image       String?
  icon        String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id           String      @id @default(cuid())
  name         String
  description  String
  price        Float
  oldPrice     Float?
  image        String
  images       String
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  rating       Float       @default(5.0)
  reviewCount  Int         @default(0)
  stock        Int         @default(50)
  brand        String      @default("أريسا")
  shades       String?
  isFeatured   Boolean     @default(false)
  isBestseller Boolean     @default(false)
  isNew        Boolean     @default(false)
  isChoice     Boolean     @default(false)
  prime        Boolean     @default(true)
  ingredients  String?
  weight       String?
  origin       String?
  createdAt    DateTime    @default(now())
  orderItems   OrderItem[]
  reviews      Review[]
}

model Order {
  id               String      @id @default(cuid())
  customerName     String
  customerPhone    String
  customerEmail    String?
  city             String
  address          String
  notes            String?
  total            Float
  status           String      @default("pending")
  paymentMethod    String      @default("cod")
  paymentStatus    String      @default("unpaid")
  trackingNumber   String?
  estimatedDelivery DateTime?
  timeline         String?
  subtotal         Float       @default(0)
  shipping         Float       @default(0)
  discount         Float       @default(0)
  tax              Float       @default(0)
  promoCode        String?
  items            OrderItem[]
  createdAt        DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Float
  image     String
  quantity  Int
  shade     String?
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  rating    Int
  title     String
  body      String
  helpful   Int      @default(0)
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Service {
  id           String           @id @default(cuid())
  name         String
  description  String
  price        Float
  oldPrice     Float?
  duration     Int
  image        String
  category     String
  icon         String
  isFeatured   Boolean          @default(false)
  isPopular    Boolean          @default(false)
  isActive     Boolean          @default(true)
  rating       Float            @default(5.0)
  reviewCount  Int              @default(0)
  whatIncluded String?
  createdAt    DateTime         @default(now())
  bookings     ServiceBooking[]
}

model ServiceBooking {
  id             String   @id @default(cuid())
  serviceId      String
  service        Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customerName   String
  customerPhone  String
  customerEmail  String?
  preferredDate  String
  preferredTime  String
  notes          String?
  status         String   @default("pending")
  totalPrice     Float
  createdAt      DateTime @default(now())
}
